{
  "name": "wijnkelder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "dev:api": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply wijnkelder --remote",
    "db:migrate:local": "wrangler d1 migrations apply wijnkelder --local"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.5.4",
    "vite": "^5.4.2",
    "wrangler": "^4.160.1"
  }
}
