{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wijnkelder",
  "account_id": "40558d1c9fd90cc8df271c00050a6ea3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wijnkelder",
      "database_id": "5c1cc6f5-f424-4464-8bd5-5546951d4082",
      "migrations_dir": "migrations"
    }
  ],
  // Alleen bereikbaar via het eigen domein (achter Cloudflare Access),
  // niet via een open *.workers.dev-adres.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "wijn.meertenhamer.nl", "custom_domain": true }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "meertenhamer.cloudflareaccess.com,crimson-wave-10f7.cloudflareaccess.com",
    "ACCESS_AUD": "e36bb8564018e50738fc77e33578ccf8e9da6e5b246ec9f2e5dc458ebe491eaa"
  },
  "observability": { "enabled": true }
}
